# ═══════════════════════════════════════════════════════════════
# NEXORA FINANCE — VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores.

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Nexora Finance"
NEXT_PUBLIC_APP_DOMAIN="nexora.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Entorno: "development" o "production"
NODE_ENV="production"
# Modo demo: "false" desactiva el usuario demo y exige sesión real
NEXT_PUBLIC_DEMO_MODE="false"
# Activar logs de depuración del proxy (afecta rendimiento)
NEXT_PUBLIC_DEBUG_PROXY="false"

# ─── Legal ─────────────────────────────────────────────────────
NEXT_PUBLIC_LEGAL_EMAIL="legal@nexora.app"
NEXT_PUBLIC_PRIVACY_EMAIL="privacidad@nexora.app"
NEXT_PUBLIC_SUPPORT_EMAIL="soporte@nexora.app"
NEXT_PUBLIC_LEGAL_ADDRESS="Bogotá D.C., República de Colombia"
NEXT_PUBLIC_LEGAL_COUNTRY="Colombia"

# ─── Base de Datos ─────────────────────────────────────────────
# MySQL connection string (Prisma)
# Formato: mysql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL="mysql://root:@localhost:3306/nexora"

# ─── Better Auth ───────────────────────────────────────────────
# Secreto para firmar cookies de sesión (mínimo 32 caracteres aleatorios)
BETTER_AUTH_SECRET="genera-un-secreto-largo-y-aleatorio-aqui"
# URL base de la app (sin slash final). Better Auth la usa para
# construir links absolutos en emails de verificación y reset.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Push Notifications (Web Push API) ─────────────────────────
# Generar claves VAPID: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_KEY="tu-vapid-public-key"
VAPID_PRIVATE_KEY="tu-vapid-private-key"
VAPID_PUBLIC_KEY="tu-vapid-public-key"
VAPID_SUBJECT="mailto:contact@nexora.app"

# ─── Archivos (uploads) ────────────────────────────────────────
# Directorio donde se guardan logos y favicons subidos desde el admin.
# Debe estar FUERA de la carpeta del proyecto para que npm run build
# no lo borre. Recomendado: /var/www/nexora-uploads
UPLOAD_DIR="/var/www/nexora-uploads"

# ─── Email (SMTP) ──────────────────────────────────────────────
# Si no se configura SMTP, el registro no requiere verificación
# de email y auto-inicia sesión tras registrarse.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="tu-app-password"
SMTP_FROM="tu-email@gmail.com"
